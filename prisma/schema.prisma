generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  goodsReceipts SupplierGoodsReceipt[]
  businessDayPolicies BusinessDayPolicy[]

  salaryProfiles EmployeeSalaryProfile[] @relation("SalaryEmployee")
  salaryProfilesRecorded EmployeeSalaryProfile[] @relation("SalaryActor")
  customRolesCreated CustomRole[]
  customRoleAssignment UserCustomRole? @relation("CustomRoleMember")
  customRolesAssigned UserCustomRole[] @relation("CustomRoleAssigner")
  id                                                                                    String                            @id @default(cuid())
  name                                                                                  String
  email                                                                                 String?                           @unique
  password                                                                              String?
  role                                                                                  Role                              @default(WAITER)
  isActive                                                                              Boolean                           @default(true)
  createdAt                                                                             DateTime                          @default(now())
  updatedAt                                                                             DateTime                          @updatedAt
  pinHash                                                                               String?                           @unique
  commissionRate                                                                        Decimal                           @default(2.00) @db.Decimal(5, 2)
  sessionVersion                                                                        Int                               @default(0)
  accounting_adjustments_accounting_adjustments_actor_idTousers                         accounting_adjustments[]          @relation("accounting_adjustments_actor_idTousers")
  accounting_adjustments_accounting_adjustments_approved_by_idTousers                   accounting_adjustments[]          @relation("accounting_adjustments_approved_by_idTousers")
  accounting_allocation_reversals_accounting_allocation_reversals_actor_idTousers       accounting_allocation_reversals[] @relation("accounting_allocation_reversals_actor_idTousers")
  accounting_allocation_reversals_accounting_allocation_reversals_approved_by_idTousers accounting_allocation_reversals[] @relation("accounting_allocation_reversals_approved_by_idTousers")
  accounting_approval_requests_accounting_approval_requests_decided_by_idTousers        accounting_approval_requests[]    @relation("accounting_approval_requests_decided_by_idTousers")
  accounting_approval_requests_accounting_approval_requests_requester_idTousers         accounting_approval_requests[]    @relation("accounting_approval_requests_requester_idTousers")
  accounting_audit_events                                                               accounting_audit_events[]
  accounting_documents                                                                  accounting_documents[]
  accounting_expense_settlements                                                        accounting_expense_settlements[]
  accounting_purchase_postings                                                          accounting_purchase_postings[]
  accounting_supplier_openings_accounting_supplier_openings_actor_idTousers             accounting_supplier_openings[]    @relation("accounting_supplier_openings_actor_idTousers")
  accounting_supplier_openings_accounting_supplier_openings_approved_by_idTousers       accounting_supplier_openings[]    @relation("accounting_supplier_openings_approved_by_idTousers")
  accounting_write_receipts                                                             accounting_write_receipts[]
  administrationEvents                                                                  AdministrationEvent[]             @relation("AdministrationActor")
  targetedAdministrationEvents                                                          AdministrationEvent[]             @relation("AdministrationTarget")
  employee_advance_recoveries                                                           employee_advance_recoveries[]
  employee_finance_allocations_employee_finance_allocations_actor_idTousers             employee_finance_allocations[]    @relation("employee_finance_allocations_actor_idTousers")
  employee_finance_allocations_employee_finance_allocations_employee_idTousers          employee_finance_allocations[]    @relation("employee_finance_allocations_employee_idTousers")
  employee_finance_cash_employee_finance_cash_actor_idTousers                           employee_finance_cash[]           @relation("employee_finance_cash_actor_idTousers")
  employee_finance_cash_employee_finance_cash_employee_idTousers                        employee_finance_cash[]           @relation("employee_finance_cash_employee_idTousers")
  employee_finance_events                                                               employee_finance_events[]
  employee_finance_operations                                                           employee_finance_operations[]
  employee_finance_receipts                                                             employee_finance_receipts[]
  employee_payroll_drafts_employee_payroll_drafts_actor_idTousers                       employee_payroll_drafts[]         @relation("employee_payroll_drafts_actor_idTousers")
  employee_payroll_drafts_employee_payroll_drafts_employee_idTousers                    employee_payroll_drafts[]         @relation("employee_payroll_drafts_employee_idTousers")
  employee_payroll_events                                                               employee_payroll_events[]
  employee_payroll_periods                                                              employee_payroll_periods[]
  employee_salary_advances_employee_salary_advances_actor_idTousers                     employee_salary_advances[]        @relation("employee_salary_advances_actor_idTousers")
  employee_salary_advances_employee_salary_advances_employee_idTousers                  employee_salary_advances[]        @relation("employee_salary_advances_employee_idTousers")
  expense_categories                                                                    expense_categories[]
  expenses                                                                              Expense[]
  financialAdjustments                                                                  FinancialAdjustment[]
  financialRequests                                                                     FinancialRequest[]                @relation("RequestActor")
  financialDecisions                                                                    FinancialRequest[]                @relation("RequestReviewer")
  paymentsTaken                                                                         Payment[]                         @relation("ReceivedPayments")
  settingsEdits                                                                         PosSettings[]                     @relation("SettingsEditor")
  purchases                                                                             Purchase[]
  accountingEvents                                                                      SaleAccountingEvent[]
  cashierSales                                                                          Sale[]                            @relation("CashierSales")
  createdSales                                                                          Sale[]                            @relation("CreatedSales")
  waiterSales                                                                           Sale[]                            @relation("WaiterSales")
  assignments                                                                           ShiftAssignment[]
  closedShifts                                                                          Shift[]                           @relation("ClosedShifts")
  openedShifts                                                                          Shift[]                           @relation("OpenedShifts")
  stockCountEvents                                                                      StockCountEvent[]
  approvedCounts                                                                        StockCount[]                      @relation("CountApprovedBy")
  stockCounts                                                                           StockCount[]                      @relation("CountedBy")
  submittedCounts                                                                       StockCount[]                      @relation("CountSubmittedBy")
  stockMovements                                                                        StockMovement[]
  supplier_credit_allocations                                                           supplier_credit_allocations[]
  supplier_credit_notes_supplier_credit_notes_approved_by_idTousers                     supplier_credit_notes[]           @relation("supplier_credit_notes_approved_by_idTousers")
  supplier_credit_notes_supplier_credit_notes_requester_idTousers                       supplier_credit_notes[]           @relation("supplier_credit_notes_requester_idTousers")
  supplier_payment_allocations                                                          supplier_payment_allocations[]
  supplier_payments                                                                     supplier_payments[]
  suppliers                                                                             suppliers[]

  @@map("users")
  refs_payroll_draft_revisions_actor_id payroll_draft_revisions[] @relation("payroll_draft_revisions_actor_id_relation")
  refs_payroll_corrections_actor_id payroll_corrections[] @relation("payroll_corrections_actor_id_relation")
  refs_payroll_correction_events_actor_id payroll_correction_events[] @relation("payroll_correction_events_actor_id_relation")
  refs_payroll_correction_applications_actor_id payroll_correction_applications[] @relation("payroll_correction_applications_actor_id_relation")
  refs_payroll_overpayment_claims_employee_id payroll_overpayment_claims[] @relation("payroll_overpayment_claims_employee_id_relation")
  refs_payroll_overpayment_recoveries_actor_id payroll_overpayment_recoveries[] @relation("payroll_overpayment_recoveries_actor_id_relation")
  refs_payroll_overpayment_recoveries_approved_by_id payroll_overpayment_recoveries[] @relation("payroll_overpayment_recoveries_approved_by_id_relation")
  refs_accounting_closed_periods_actor_id accounting_closed_periods[] @relation("accounting_closed_periods_actor_id_relation")
  refs_accounting_closed_periods_approved_by_id accounting_closed_periods[] @relation("accounting_closed_periods_approved_by_id_relation")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  operationalLocation String?
  id              String             @id @default(cuid())
  name            String
  type            ProductType        @default(simple)
  categoryId      String?
  unitOfMeasure   String             @default("pcs")
  cost            Decimal            @default(0) @db.Decimal(12, 2)
  price           Decimal            @db.Decimal(12, 2)
  wholesalePrice  Decimal?           @db.Decimal(12, 2)
  quantity        Decimal            @default(0) @db.Decimal(12, 6)
  productCode     String             @unique
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  countSessionId  String?
  returnsAllowed  Boolean            @default(true)
  usedIn          ProductComponent[] @relation("ComponentProduct")
  components      ProductComponent[] @relation("ParentProduct")
  category        Category?          @relation(fields: [categoryId], references: [id])
  countSession    StockCount?        @relation("ProductCountClaim", fields: [countSessionId], references: [id], onDelete: Restrict)
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  stockCountItems StockCountItem[]
  stockMovements  StockMovement[]

  @@index([categoryId])
  @@index([countSessionId])
  @@index([productCode])
  @@map("products")
}

model ProductComponent {
  id                 String  @id @default(cuid())
  parentProductId    String
  componentProductId String
  quantity           Decimal @db.Decimal(12, 6)
  componentProduct   Product @relation("ComponentProduct", fields: [componentProductId], references: [id])
  parentProduct      Product @relation("ParentProduct", fields: [parentProductId], references: [id], onDelete: Cascade)

  @@unique([parentProductId, componentProductId])
  @@map("product_components")
}

model Sale {
  id                           String                         @id @default(cuid())
  saleNumber                   String                         @unique @default(dbgenerated("next_order_number()"))
  status                       SaleStatus                     @default(UNPAID)
  subtotal                     Decimal                        @default(0) @db.Decimal(12, 2)
  discount                     Decimal                        @default(0) @db.Decimal(12, 2)
  total                        Decimal                        @default(0) @db.Decimal(12, 2)
  amountPaid                   Decimal                        @default(0) @db.Decimal(12, 2)
  balance                      Decimal                        @default(0) @db.Decimal(12, 2)
  notes                        String?
  waiterId                     String?
  cashierId                    String?
  createdById                  String?
  shiftId                      String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  mergedIntoId                 String?
  accountingDate               DateTime?                      @db.Date
  commissionRateSnapshot       Decimal?                       @db.Decimal(5, 2)
  commissionEarnedAt           DateTime?
  commissionAmount             Decimal?                       @db.Decimal(12, 2)
  splitFromId                  String?
  splitRequestId               String?                        @unique @db.Uuid
  commissionCapSnapshot        Decimal?                       @db.Decimal(12, 2)
  docket                       Docket?
  employee_finance_allocations employee_finance_allocations[]
  employee_finance_receipts    employee_finance_receipts[]
  employee_settlement_links    employee_settlement_links[]
  financialAdjustments         FinancialAdjustment[]
  financialRequests            FinancialRequest[]
  payments                     Payment[]
  accountingEvents             SaleAccountingEvent[]
  items                        SaleItem[]
  originalStockItems           SaleItem[]                     @relation("StockOrigin")
  cashier                      User?                          @relation("CashierSales", fields: [cashierId], references: [id])
  createdBy                    User?                          @relation("CreatedSales", fields: [createdById], references: [id])
  shift                        Shift?                         @relation(fields: [shiftId], references: [id])
  splitFrom                    Sale?                          @relation("SplitOrigin", fields: [splitFromId], references: [id], onDelete: Restrict)
  splitChildren                Sale[]                         @relation("SplitOrigin")
  waiter                       User?                          @relation("WaiterSales", fields: [waiterId], references: [id])

  @@index([status])
  @@index([waiterId])
  @@index([shiftId])
  @@map("sales")
}

model SaleItem {
  operationalLocation String?
  id                   String                @id @default(cuid())
  saleId               String
  productId            String
  quantity             Float
  unitPrice            Decimal               @db.Decimal(12, 2)
  unitCost             Decimal               @default(0) @db.Decimal(12, 2)
  discount             Decimal               @default(0) @db.Decimal(12, 2)
  subtotal             Decimal               @db.Decimal(12, 2)
  stockDeductionCount  Int?
  removedAt            DateTime?
  returnEligible       Boolean?
  stockOriginSaleId    String?
  financialAdjustments FinancialAdjustment[]
  financialRequests    FinancialRequest[]
  product              Product               @relation(fields: [productId], references: [id])
  sale                 Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockOriginSale      Sale?                 @relation("StockOrigin", fields: [stockOriginSaleId], references: [id], onDelete: Restrict)
  stockMovements       StockMovement[]

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id                   String               @id @default(cuid())
  saleId               String
  method               PaymentMethod
  amount               Decimal              @db.Decimal(12, 2)
  reference            String?
  receivedById         String?
  createdAt            DateTime             @default(now())
  receivedShiftId      String?
  voidAdjustment       FinancialAdjustment? @relation("VoidedPayment")
  settlementAdjustment FinancialAdjustment? @relation("SettlementPayment")
  financialRequests    FinancialRequest[]
  receivedBy           User?                @relation("ReceivedPayments", fields: [receivedById], references: [id])
  receivedShift        Shift?               @relation("ReceivedShiftPayments", fields: [receivedShiftId], references: [id])
  sale                 Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([receivedShiftId])
  @@map("payments")
}

model Docket {
  id        String       @id @default(cuid())
  saleId    String       @unique
  status    DocketStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("dockets")
}

model Shift {
  businessDayPeriodId String? @map("business_day_period_id") @db.Uuid
  businessDayPeriod BusinessDayPeriod? @relation(fields: [businessDayPeriodId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  goodsReceipts SupplierGoodsReceipt[]
  @@index([businessDayPeriodId], map: "shifts_business_day_period")

  id                              String                            @id @default(cuid())
  name                            String?
  status                          ShiftStatus                       @default(OPEN)
  openingCash                     Decimal                           @default(0) @db.Decimal(12, 2)
  closingCash                     Decimal?                          @db.Decimal(12, 2)
  expectedCash                    Decimal?                          @db.Decimal(12, 2)
  notes                           String?
  openedById                      String
  closedById                      String?
  openedAt                        DateTime                          @default(now())
  closedAt                        DateTime?
  accounting_adjustments          accounting_adjustments[]
  accounting_allocation_reversals accounting_allocation_reversals[]
  accounting_expense_settlements  accounting_expense_settlements[]
  accounting_supplier_openings    accounting_supplier_openings[]
  employee_finance_allocations    employee_finance_allocations[]
  employee_finance_cash           employee_finance_cash[]
  employee_finance_receipts       employee_finance_receipts[]
  employee_salary_advances        employee_salary_advances[]
  expenses                        Expense[]
  financialAdjustments            FinancialAdjustment[]
  receivedPayments                Payment[]                         @relation("ReceivedShiftPayments")
  purchases                       Purchase[]
  sales                           Sale[]
  assignments                     ShiftAssignment[]
  closedBy                        User?                             @relation("ClosedShifts", fields: [closedById], references: [id])
  openedBy                        User                              @relation("OpenedShifts", fields: [openedById], references: [id])
  supplier_credit_notes           supplier_credit_notes[]
  supplier_payments               supplier_payments[]

  @@index([status])
  @@map("shifts")
}

model ShiftAssignment {
  id        String   @id @default(cuid())
  shiftId   String
  userId    String
  createdAt DateTime @default(now())
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@map("shift_assignments")
}

model StockMovement {
  goodsReceiptLine SupplierGoodsReceiptLine?

  id                                                                                    String                    @id @default(cuid())
  productId                                                                             String
  type                                                                                  StockMovementType
  quantityChange                                                                        Decimal                   @db.Decimal(12, 6)
  previousQty                                                                           Decimal                   @db.Decimal(12, 6)
  quantityAfter                                                                         Decimal                   @db.Decimal(12, 6)
  reason                                                                                String?
  saleId                                                                                String?
  userId                                                                                String?
  createdAt                                                                             DateTime                  @default(now())
  saleItemId                                                                            String?
  reversalOfId                                                                          String?                   @unique
  stockCountItemId                                                                      String?                   @unique
  returnPortionId                                                                       String?                   @unique
  purchaseItemId                                                                        String?                   @unique
  accounting_credit_items_accounting_credit_items_movement_idTostock_movements          accounting_credit_items?  @relation("accounting_credit_items_movement_idTostock_movements")
  accounting_credit_items_accounting_credit_items_original_movement_idTostock_movements accounting_credit_items[] @relation("accounting_credit_items_original_movement_idTostock_movements")
  product                                                                               Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItem                                                                          PurchaseItem?             @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  returnPortion                                                                         StockReturnPortion?       @relation("ReturnMovement", fields: [returnPortionId], references: [id], onDelete: Restrict)
  reversalOf                                                                            StockMovement?            @relation("StockReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal                                                                              StockMovement?            @relation("StockReversal")
  saleItem                                                                              SaleItem?                 @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  stockCountItem                                                                        StockCountItem?           @relation(fields: [stockCountItemId], references: [id], onDelete: Restrict)
  user                                                                                  User?                     @relation(fields: [userId], references: [id])
  returnPortions                                                                        StockReturnPortion[]      @relation("OriginalMovement")

  @@index([productId])
  @@index([saleItemId])
  @@map("stock_movements")
}

model StockCount {
  id              String            @id @default(cuid())
  status          StockCountStatus  @default(DRAFT)
  notes           String?
  countedById     String?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?
  baselineAt      DateTime?
  readyAt         DateTime?
  expiresAt       DateTime?
  submittedAt     DateTime?
  submittedById   String?
  approvedById    String?
  stockApplied    Boolean?
  claimedProducts Product[]         @relation("ProductCountClaim")
  events          StockCountEvent[]
  items           StockCountItem[]
  approvedBy      User?             @relation("CountApprovedBy", fields: [approvedById], references: [id])
  countedBy       User?             @relation("CountedBy", fields: [countedById], references: [id])
  submittedBy     User?             @relation("CountSubmittedBy", fields: [submittedById], references: [id])

  @@map("stock_counts")
}

model StockCountItem {
  id                    String         @id @default(cuid())
  stockCountId          String
  productId             String
  systemQty             Decimal        @db.Decimal(12, 6)
  countedQty            Decimal?       @db.Decimal(12, 6)
  difference            Decimal?       @db.Decimal(12, 6)
  baselineMovementCount Int?
  product               Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockCount            StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  correction            StockMovement?

  @@unique([stockCountId, productId])
  @@map("stock_count_items")
}

model StockCountEvent {
  id           String     @id @default(cuid())
  stockCountId String
  userId       String?
  action       String
  details      Json?
  createdAt    DateTime   @default(now())
  stockCount   StockCount @relation(fields: [stockCountId], references: [id])
  user         User?      @relation(fields: [userId], references: [id])

  @@index([stockCountId])
  @@map("stock_count_events")
}

model RolePermission {
  id         String   @id @default(cuid())
  role       Role
  permission String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

model Expense {
  id                             String                           @id @default(cuid())
  amount                         Decimal                          @db.Decimal(12, 2)
  category                       String
  description                    String
  createdAt                      DateTime                         @default(now())
  recordedById                   String?
  method                         PaymentMethod                    @default(CASH)
  shiftId                        String?
  expenseNumber                  String                           @unique
  categoryId                     String?
  categoryKindSnapshot           String?
  paymentStatus                  String                           @default("PAID")
  supplierId                     String?
  reference                      String?
  accounting_adjustments         accounting_adjustments[]
  accounting_documents           accounting_documents?
  accounting_expense_settlements accounting_expense_settlements[]
  expense_categories             expense_categories?              @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recordedBy                     User?                            @relation(fields: [recordedById], references: [id])
  shift                          Shift?                           @relation(fields: [shiftId], references: [id])
  suppliers                      suppliers?                       @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchase                       Purchase?
  supplier_payments              supplier_payments?

  @@index([categoryId, createdAt, id], map: "expenses_category_id_date")
  @@map("expenses")
}

model Purchase {
  separateReceiving SupplierInvoiceReceiving?

  id                           String                        @id @default(cuid())
  invoiceNumber                String?
  supplierName                 String
  totalAmount                  Decimal                       @db.Decimal(12, 2)
  method                       PaymentMethod                 @default(CASH)
  createdAt                    DateTime                      @default(now())
  recordedById                 String?
  purchaseNumber               String                        @unique
  clientKey                    String?                       @unique
  requestHash                  String?
  invoiceDate                  DateTime?                     @db.Date
  shiftId                      String?
  expenseId                    String?                       @unique
  supplierId                   String?
  settlementMode               String?
  accounting_adjustments       accounting_adjustments[]
  accounting_documents         accounting_documents?
  accounting_purchase_postings accounting_purchase_postings?
  items                        PurchaseItem[]
  expense                      Expense?                      @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  recordedBy                   User?                         @relation(fields: [recordedById], references: [id])
  shift                        Shift?                        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  suppliers                    suppliers?                    @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([invoiceDate])
  @@index([shiftId, createdAt])
  @@index([supplierId, createdAt, id], map: "purchases_supplier_date")
  @@map("purchases")
}

model PurchaseItem {
  goodsReceiptLines SupplierGoodsReceiptLine[]

  id                      String                    @id @default(cuid())
  purchaseId              String
  productId               String
  quantity                Decimal                   @db.Decimal(12, 6)
  unitCost                Decimal                   @db.Decimal(12, 2)
  totalCost               Decimal                   @db.Decimal(12, 2)
  accounting_credit_items accounting_credit_items[]
  product                 Product                   @relation(fields: [productId], references: [id])
  purchase                Purchase                  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  stockMovement           StockMovement?

  @@map("purchase_items")
}

model SaleAccountingEvent {
  id        String   @id @default(cuid())
  saleId    String
  actorId   String
  action    String
  reason    String?
  details   Json
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id])

  @@index([saleId, createdAt])
  @@map("sale_accounting_events")
}

model FinancialRequest {
  id             String               @id @default(cuid())
  kind           String
  saleId         String
  paymentId      String?
  saleItemId     String?
  quantity       Decimal?             @db.Decimal(12, 6)
  reason         String
  payload        Json
  requestedById  String
  reviewedById   String?
  status         String               @default("PENDING")
  decisionReason String?
  createdAt      DateTime             @default(now())
  decidedAt      DateTime?
  clientKey      String               @unique
  adjustment     FinancialAdjustment?
  payment        Payment?             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy    User                 @relation("RequestActor", fields: [requestedById], references: [id])
  reviewedBy     User?                @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  sale           Sale                 @relation(fields: [saleId], references: [id])
  saleItem       SaleItem?            @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([saleId])
  @@map("financial_requests")
}

model FinancialAdjustment {
  id                        String                     @id @default(cuid())
  requestId                 String?                    @unique
  saleId                    String
  paymentId                 String?                    @unique
  settlementPaymentId       String?                    @unique
  saleItemId                String?
  kind                      String
  quantity                  Decimal?                   @db.Decimal(12, 6)
  salesDelta                Decimal                    @default(0) @db.Decimal(12, 2)
  collectionDelta           Decimal                    @default(0) @db.Decimal(12, 2)
  costDelta                 Decimal                    @default(0) @db.Decimal(12, 2)
  commissionDelta           Decimal                    @default(0) @db.Decimal(12, 2)
  shiftId                   String?
  actorId                   String
  reason                    String
  createdAt                 DateTime                   @default(now())
  clientKey                 String?                    @unique
  cashEntries               AdjustmentCashEntry[]
  employee_settlement_links employee_settlement_links?
