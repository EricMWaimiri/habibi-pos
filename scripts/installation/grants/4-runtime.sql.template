-- REVIEW ONLY. Run separately as the existing designated migration role.
BEGIN;
SET LOCAL lock_timeout='5s';
DO $guard$ BEGIN
 IF current_database() IS DISTINCT FROM '{{DATABASE}}' OR (SELECT oid FROM pg_database WHERE datname=current_database()) IS DISTINCT FROM {{OID}}
 OR current_user IS DISTINCT FROM '{{MIGRATION_ROLE}}'
 OR host(inet_server_addr()) IS DISTINCT FROM '127.0.0.1' OR inet_server_port() IS DISTINCT FROM {{PORT}}
 OR (SELECT system_identifier::text FROM pg_control_system()) IS DISTINCT FROM '{{CLUSTER}}'
 THEN RAISE EXCEPTION 'Unapproved grant target'; END IF;
END $guard$;
GRANT SELECT, INSERT ON public.employee_salary_profiles TO {{RUNTIME_ROLE}};
GRANT SELECT, INSERT ON public.custom_roles TO {{RUNTIME_ROLE}};
GRANT UPDATE(name,base_role,is_active,version,updated_at) ON public.custom_roles TO {{RUNTIME_ROLE}};
GRANT SELECT, INSERT ON public.custom_role_permissions TO {{RUNTIME_ROLE}};
GRANT UPDATE(enabled) ON public.custom_role_permissions TO {{RUNTIME_ROLE}};
GRANT SELECT, INSERT ON public.user_custom_roles TO {{RUNTIME_ROLE}};
GRANT UPDATE(role_id,version,assigned_by_id,updated_at) ON public.user_custom_roles TO {{RUNTIME_ROLE}};
GRANT INSERT(id,name,description,"isActive","createdAt","updatedAt") ON public.categories TO {{RUNTIME_ROLE}};
GRANT UPDATE(name,description,"isActive","updatedAt") ON public.categories TO {{RUNTIME_ROLE}};
GRANT INSERT(id,"parentProductId","componentProductId",quantity) ON public.product_components TO {{RUNTIME_ROLE}};
GRANT UPDATE(quantity) ON public.product_components TO {{RUNTIME_ROLE}};
-- Existing SELECT on categories/components and INSERT/UPDATE on products,
-- sale_items and INSERT on administration_events are reused unchanged.
-- No sequence privileges needed: UUID/cuid IDs generated by application.
-- No DELETE/TRUNCATE/ownership/CREATE/role memberships or journal mutation.
COMMIT;
